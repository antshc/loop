        <mxCell id="I9oRm3RWguibgEzQ6AS1-46" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" value="&lt;div&gt;&lt;span style=&quot;font-weight: 700; text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;AgentProcess&lt;/span&gt;=&lt;span style=&quot;font-weight: 700; text-align: center;&quot;&gt;AgentProvider&lt;/span&gt;.create()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 700; text-align: center;&quot;&gt;AgentProvider&lt;/span&gt;.create():&amp;nbsp;&lt;span style=&quot;font-weight: 700; text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;AgentRunner&lt;/span&gt;&lt;/div&gt;&lt;div&gt;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Create worktree using the&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: 700; text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;WorktreeProvider&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-weight: 700; text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;AgentProcess incapsulate the&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;WorktreeSpace, and teh&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;AgentClient&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- when the&amp;nbsp;&lt;span style=&quot;font-weight: 700; text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;AgentProcess implemtnat teh wit Resource () pattern and dispose&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;WorktreeSpace,&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;AgentClient&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;SessionId!=&lt;span style=&quot;font-weight: 700; text-align: center;&quot;&gt;AgentProcess.run&lt;/span&gt;(prompt, args)&lt;/div&gt;&lt;div&gt;Start new conversation execute prompt&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;SessionId2=&lt;span style=&quot;font-weight: 700; text-align: center;&quot;&gt;AgentProcess&lt;/span&gt;.&lt;span style=&quot;font-weight: 700; text-align: center;&quot;&gt;run&lt;/span&gt;(prompt,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SessionId,&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;args)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;if session id provided execute in the same session&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Create PR&lt;/div&gt;&lt;div&gt;Close ticket&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-weight: 700; text-align: center;&quot;&gt;AgentProcess&lt;/span&gt;.exit()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NoSandbox - the development heppend on the host&lt;/div&gt;&lt;div&gt;DockerSandbox - the worktrees managment, creating prs,reading github issues on the host. The docker mounts the directory and agent send the prompt to the copilt runnet on the docker. The copilot on the docker does commits.&lt;/div&gt;" vertex="1">
          <mxGeometry height="434" width="480" x="2410" y="490" as="geometry" />
        </mxCell>
